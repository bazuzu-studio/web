# Dokploy: задайте эти переменные во вкладке Environment сервиса Compose.
# Локально: cp .env.example .env.local

# Публичный URL сайта (metadata, sitemap.xml, robots.txt) — вшивается при сборке
NEXT_PUBLIC_SITE_URL=https://otakuum.ru

# Публичный URL GraphQL API (Payload CMS) — используется в браузере, вшивается при сборке
NEXT_PUBLIC_GRAPHQL_API_URL=https://cms.otakuum.ru/api/graphql

# Необязательно: адрес GraphQL для серверных запросов (по умолчанию = NEXT_PUBLIC_GRAPHQL_API_URL)
# GRAPHQL_API_URL=http://<cms-internal-host>:<port>/api/graphql

# Публичный URL S3/MinIO — для next/image (вшивается при сборке)
S3_PUBLIC_URL=https://s3.otakuum.ru/media
