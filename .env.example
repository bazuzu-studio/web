# Dokploy: задайте эти переменные во вкладке Environment сервиса Compose.
# Локально: cp .env.example .env.local

# Публичный URL сайта (metadata, sitemap.xml, robots.txt) — вшивается при сборке
NEXT_PUBLIC_SITE_URL=https://otakuum.ru

# Публичный URL GraphQL API (Payload CMS) — используется в браузере, вшивается при сборке
NEXT_PUBLIC_GRAPHQL_API_URL=https://cms.otakuum.ru/api/graphql

# Необязательно: адрес GraphQL для серверных (SSR) запросов, например внутренний
# docker-адрес CMS (по умолчанию = NEXT_PUBLIC_GRAPHQL_API_URL). Браузер его не видит
# и не использует — все клиентские запросы, включая форму обратной связи
# (см. src/lib/cms.ts), всегда идут на публичный NEXT_PUBLIC_GRAPHQL_API_URL.
# GRAPHQL_API_URL=http://<cms-internal-host>:<port>/api/graphql

# Публичный URL S3/MinIO — для next/image (вшивается при сборке)
S3_PUBLIC_URL=https://s3.otakuum.ru/media

# Секрет для POST /api/revalidate: CMS (и пайплайн после sync) дёргают его,
# чтобы сайт сразу обновил кэш контента, а не через 60 секунд.
# Тот же REVALIDATE_SECRET задаётся в окружении CMS (вместе с REVALIDATE_URL —
# адресом этого сайта, доступным из контейнера CMS). Генерация: openssl rand -hex 32
# REVALIDATE_SECRET=
